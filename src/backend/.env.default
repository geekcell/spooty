DB_PATH=./config/db.sqlite
FE_PATH=../frontend/browser
DOWNLOADS_PATH=./downloads
FORMAT=mp3
QUALITY=
PORT=3000
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_RUN=false

# NOTE: DOWNLOAD_CONCURRENCY, DOWNLOAD_GAP_MS and SEARCH_CONCURRENCY are
# deliberately not set here. They are read at module-import time, before this
# file is loaded, so setting them here would have no effect. Export them as real
# environment variables instead.
#
# YouTube cookies are supplied as a Netscape-format file at /spooty/cookies.txt
# (or the equivalent path for a source install), not as an environment variable.
# Never commit that file. See the README.