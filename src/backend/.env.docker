DB_PATH=./config/db.sqlite
FE_PATH=../frontend/browser
DOWNLOADS_PATH=./downloads
FORMAT=mp3
PORT=3000
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_RUN=true

# NOTE: DOWNLOAD_CONCURRENCY, DOWNLOAD_GAP_MS and SEARCH_CONCURRENCY are
# deliberately not set here. They are read at module-import time, before this
# file is loaded, so setting them here would have no effect. Pass them as real
# environment variables (docker run -e / compose `environment:`) instead.
#
# YouTube cookies are supplied as a Netscape-format file mounted at
# /spooty/cookies.txt, not as an environment variable. See the README.